# Även text/XML-resurser får de två billiga, entydiga klickjacking-/MIME-
# skydden. De påverkar inte robotar eller XML-konsumenter och håller statiska
# svar konsekventa med SSR-svaren.
/robots.txt
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

/sitemap.xml
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

/.well-known/security.txt
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

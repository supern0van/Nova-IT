{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "pnpm test && pnpm lint && pnpm exec tsc --noEmit --pretty false && pnpm exec opennextjs-cloudflare build",
    "worker:deployments": "wrangler deployments list --name nova-it-admin",
    "worker:secrets": "wrangler secret list --name nova-it-admin",
    "worker:secrets:check": "node scripts/check-worker-secrets.mjs",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "release:check": "pnpm test && pnpm lint && pnpm exec tsc --noEmit --pretty false && pnpm worker:secrets:check && pnpm smoke:worker",
    "release:predeploy": "pnpm run ci && pnpm deploy:dry-run && pnpm worker:secrets:check && pnpm smoke:worker",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dry-run": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "packageManager": "pnpm@10.0.0"
}

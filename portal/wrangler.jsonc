{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-it-admin",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    // admin.* är adminportalens primära, permanenta ingång (nova-it-admin).
    {
      "pattern": "admin.nova-it.se",
      "custom_domain": true
    },
    {
      "pattern": "admin.novait.se",
      "custom_domain": true
    },
    // portal.* är tillfälligt kopplade hit så att domänerna är registrerade och
    // fungerar redan nu. Det är en bekvämlighet, inte en avsedd arkitektur.
    // Bygg inte en kundportal genom att lägga till kod eller routes i nova-it-admin.
    // En framtida kundportal kräver en egen Worker och egna routes, beslutat
    // separat när det spåret faktiskt påbörjas.
    {
      "pattern": "portal.novait.se",
      "custom_domain": true
    },
    {
      "pattern": "portal.nova-it.se",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "PUBLIC_INTAG_SECRET"
    ]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nova-it-admin"
    }
  ]
}

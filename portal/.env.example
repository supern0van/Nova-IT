NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only – SAKNAR NEXT_PUBLIC_-prefix med avsikt: får ALDRIG paketeras
# till klienten. Används enbart av lib/supabase/service.ts (t.ex. /api/roll)
# för att läsa profiles-tabellen, som saknar klientprivilegier.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only – delad hemlighet för det publika ärendeintaget från
# nova-it.se (app/api/public/intag/route.ts). Verifierar att anropet
# faktiskt kommer från den publika webbplatsens serverfunktion, inte
# direkt från en besökares webbläsare. Roteras oberoende av övriga secrets.
INTAG_SECRET=

# Server-only – 46elks-konto för att skicka SMS till kund ("klart för
# upphämtning", se lib/admin/sms-server.ts). Valfria: om de saknas visas
# ett tydligt fel när knappen används, men resten av portalen fungerar
# oförändrat (samma soft-fail-princip som Turnstile på den publika sajten).
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
# Avsändarnamn i SMS:et. Max 11 tecken, inga mellanslag. Standard: NovaIT.
SMS_AVSANDARE=

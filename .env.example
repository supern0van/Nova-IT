# Nova IT frontend environment
#
# Keep real secrets out of frontend code and out of Git.
# Public browser variables must be safe to expose.

# Public contact address used to open a prepared email draft after the form is completed.
# This value is intentionally public. Do not put secrets, API keys, or tokens here.
# VITE_NOVA_CONTACT_EMAIL=support@your-domain.se

# Optional public site URL used by future metadata or deploy checks.
# VITE_SITE_URL=https://example.com

# Nova IT frontend environment
#
# Keep real secrets out of frontend code and out of Git.
# Public browser variables must be safe to expose.

# Optional public site URL used by future metadata or deploy checks.
# VITE_SITE_URL=https://nova-it.se

# Server-side contact form delivery. Never prefix these with VITE_ and never
# commit real values. Set the same values as Cloudflare Worker secrets.
# RESEND_API_KEY=re_replace_with_a_sending_only_key
# CONTACT_FORM_FROM="Nova IT <no-reply@nova-it.se>"
# CONTACT_FORM_TO=kontakt@nova-it.se

# Secure server-to-server ticket intake into the admin portal
# (portal/app/api/public/intag/route.ts). ADMIN_INTAKE_URL is the admin
# Worker's base URL; INTAG_SECRET must match the same-named secret
# configured on the admin Worker exactly. Never prefix with VITE_.
# ADMIN_INTAKE_URL=https://admin.nova-it.se
# INTAG_SECRET=replace_with_a_long_random_shared_secret

# Cloudflare Turnstile spam protection on the contact form. The Site Key is
# public by design, but is read runtime from the Worker rather than baked into
# the Vite build. TURNSTILE_SITE_KEY is preferred; the legacy
# VITE_TURNSTILE_SITE_KEY name is also supported during migration.
# TURNSTILE_SITE_KEY=replace_with_your_turnstile_site_key
# VITE_TURNSTILE_SITE_KEY=replace_with_your_turnstile_site_key
# TURNSTILE_SECRET_KEY is server-only and must never reach client code.
# TURNSTILE_SECRET_KEY=replace_with_your_turnstile_secret_key

# Locks the public ticket intake without taking the site down. The whole site,
# including the local support assistant, keeps working; only the submission is
# refused, and the contact page points visitors to e-mail instead. Intended for
# the window before the external penetration test and legal review are done.
#
# Server-only and never prefixed with VITE_ - it must not be settable from the
# browser. Any value other than "stangd" (including a missing or misspelled
# one) means the intake stays OPEN, so it can never silently disable itself.
# The binding check runs server-side in skickaKontaktforfragan().
# PUBLIK_INTAG_LAGE=stangd

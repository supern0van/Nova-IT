# Nova IT frontend environment
#
# Keep real secrets out of frontend code and out of Git.
# Public browser variables must be safe to expose.

# Optional public site URL used by future metadata or deploy checks.
# VITE_SITE_URL=https://nova-it.se

# Server-side contact form delivery. Never prefix these with VITE_ and never
# commit real values. Set the same values as Cloudflare Worker secrets.
# RESEND_API_KEY=re_replace_with_a_sending_only_key
# CONTACT_FORM_FROM="Nova IT <no-reply@nova-it.se>"
# CONTACT_FORM_TO=kontakt@nova-it.se

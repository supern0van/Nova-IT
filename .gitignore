# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.agents/
.codex/
outputs/
# Engångsartefakter från lokala körningar/granskningar (t.ex. skärmdumpar,
# renderade PDF-slides) - inte dokumentation, ska aldrig checkas in. Elva
# PNG-filer hade av misstag smugit sig in innan denna rad fanns - städade
# bort samtidigt som raden lades till.
tmp/
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Lokala miljövariabler. .env.example instruerar uttryckligen att lägga
# RESEND_API_KEY, INTAG_SECRET och TURNSTILE_SECRET_KEY i en lokal env-fil -
# de får aldrig kunna committas av misstag. Bara .env.example spåras.
.env
.env.*
!.env.example

# Local, machine-specific Claude Code tool permissions
.claude/settings.local.json

# Playwright E2E-körningar (rapporter, spår, skärmdumpar) - engångsartefakter
# från lokala/CI-körningar, inte källkod.
/test-results/
/playwright-report/
/blob-report/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

{
  "name": "nova-it-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite dev",
    "sitemap": "bun scripts/generate-sitemap.mjs",
    "build": "bun run sitemap && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy": "bun run deploy:production",
    "deploy:production": "bun run build && bunx wrangler deploy",
    "deploy:preview": "bun run build && bunx wrangler deploy --temporary",
    "test": "bun test src/features src/components",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit --pretty false -p e2e/tsconfig.json",
    "typecheck": "tsc --noEmit --pretty false",
    "ci": "bun run test && bun run lint && bun run typecheck && bun run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "audit:cloudflare-live": "bun scripts/cloudflare-live-audit.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
